{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "node",
      "nativewind/types"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server",
    "drizzle",
    "drizzle.config.ts",
    "tests",
    "__tests__",
    "lib/trpc.ts",
    "lib/_core/api.ts",
    "lib/_core/auth.ts",
    "hooks/use-auth.ts",
    "app/oauth/callback.tsx",
    "components/external-link.tsx",
    "shared/types.ts",
    "services/aiConfig.ts",
    "services/aiService.ts"
  ]
}
