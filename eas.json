{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk", "image": "latest" },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle", "image": "latest" },
      "ios": { "image": "latest" },
      "channel": "production"
    }
  },
  "submit": { "production": {} }
}
